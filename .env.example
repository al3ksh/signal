# Leave loopback binding in place when using a local reverse proxy or SSH tunnel.
# For direct trusted LAN access, change to 0.0.0.0 and configure your firewall.
SIGNAL_HOST=127.0.0.1
SIGNAL_PORT=8091
SIGNAL_NODE_NAME=
SIGNAL_INTERVAL=5
SIGNAL_TEMP_LIMIT=80
# Filled automatically by `sh ./signal start`.
DOCKER_GID=
DOCKER_SOCKET=/var/run/docker.sock
