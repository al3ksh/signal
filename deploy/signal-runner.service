# SIGNAL runner: the only SIGNAL process that changes Docker or git state.
#
# TRUST BOUNDARY: membership of the docker group is equivalent to root on this host.
# Anyone who can write to /run/signal-runner/control.sock can start, stop, update and
# roll back the apps listed in /etc/signal/apps.json, and nothing else. Keep the socket
# group limited to the SIGNAL web user, and keep /etc/signal/apps.json root-owned (0644).
[Unit]
Description=SIGNAL app runner (start, stop, update and roll back registered Compose apps)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=alexpi
Group=alexpi
SupplementaryGroups=docker
WorkingDirectory=/home/alexpi/apps/signal
ExecStart=/usr/bin/python3 /home/alexpi/apps/signal/runner.py
Environment=SIGNAL_RUNNER_REGISTRY=/etc/signal/apps.json
Environment=SIGNAL_RUNNER_DATA_DIR=/var/lib/signal-runner
Environment=SIGNAL_RUNNER_SOCKET=/run/signal-runner/control.sock
Environment=SIGNAL_RUNNER_CHECK_INTERVAL=900
# Hardening (docs/APP-CONTROL.md, "Run SIGNAL without Docker access"): hand the sockets to a
# group shared with a separate SIGNAL user and serve it a GET-only Docker socket.
#Environment=SIGNAL_RUNNER_SOCKET_GROUP=signal-control
#Environment=SIGNAL_RUNNER_DOCKER_PROXY=/run/signal-runner/docker-ro.sock
RuntimeDirectory=signal-runner
# Sockets inside are 0660; the directory only needs to be traversable.
RuntimeDirectoryMode=0755
StateDirectory=signal-runner
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
# Stopping cancels running jobs, which roll back. Give that time; a deploy cut off anyway is
# rolled back automatically on the next start.
TimeoutStopSec=90
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/signal-runner /home/alexpi/apps -/home/alexpi/.docker
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027

[Install]
WantedBy=multi-user.target
