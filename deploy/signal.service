[Unit]
Description=SIGNAL Linux and Docker observatory
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=signal
Group=signal
SupplementaryGroups=docker
# With app control's read-only Docker proxy, drop the docker group instead:
#SupplementaryGroups=signal-control
#Environment=DOCKER_SOCKET=/run/signal-runner/docker-ro.sock
WorkingDirectory=/opt/signal
ExecStart=/usr/bin/python3 /opt/signal/server.py
Environment=SIGNAL_HOST=127.0.0.1
Environment=SIGNAL_PORT=8091
Environment=SIGNAL_DATA_DIR=/var/lib/signal
# Optional app control (see docs/APP-CONTROL.md). Leave unset to keep SIGNAL read-only.
#Environment=SIGNAL_CONTROL_SOCKET=/run/signal-runner/control.sock
#Environment=SIGNAL_CONTROL_ALLOW=100.64.0.0/10,127.0.0.1/32,::1/128,fd7a:115c:a1e0::/48
StateDirectory=signal
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/signal
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
